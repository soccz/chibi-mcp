{
  "name": "chibi-mcp",
  "displayName": "chibi (chibi-mcp)",
  "description": "Korean rice cake desktop pet for VS Code. Gacha-collect characters, apply 12 free option layers, and react to your coding session.",
  "version": "0.5.3",
  "publisher": "soccz",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other", "Visualization"],
  "keywords": ["pet", "desktop pet", "kawaii", "chibi", "gacha", "korean", "asmr", "cosmetics"],
  "icon": "resources/garaetteok_short.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "chibiMcpContainer",
          "title": "chibi",
          "icon": "$(symbol-color)"
        }
      ]
    },
    "views": {
      "chibiMcpContainer": [
        {
          "type": "webview",
          "id": "chibiMcp.petView",
          "name": "chibi",
          "icon": "$(symbol-color)",
          "contextualTitle": "chibi"
        }
      ]
    },
    "commands": [
      {
        "command": "chibiMcp.gacha",
        "title": "chibi: 뽑기"
      },
      {
        "command": "chibiMcp.collection",
        "title": "chibi: 보관함"
      },
      {
        "command": "chibiMcp.reset",
        "title": "chibi: 보관함 초기화"
      }
    ],
    "configuration": {
      "title": "chibi",
      "properties": {
        "chibiMcp.sayBridge.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Fire `chibi-say` speech bubbles in the floating chibi window when you save, run tasks, or debug. Requires `chibi-say` on PATH (installed with the chibi-mcp Python package)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc -p ./ --noEmit",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/soccz/chibi-mcp.git"
  }
}
